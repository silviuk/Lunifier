# Cloudflare R2 Bucket Configuration for Lunifier MSIX Packages
# Copy this file to .env and fill in your details, or add these to your GitHub Repository Secrets.

# 1. Cloudflare Account ID (Found in Cloudflare Dashboard under R2 Overview)
R2_ACCOUNT_ID=

# 2. Cloudflare R2 API Token (Created in R2 Dashboard -> "Manage R2 API Tokens" -> Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 3. R2 Bucket Name
R2_BUCKET_NAME=

# 4. Optional Configurations:
# Folder/prefix inside bucket (default: msix/)
R2_PREFIX=msix/

# Public URL (if your R2 bucket has a custom domain or r2.dev public URL enabled)
# R2_PUBLIC_URL=https://r2.yourdomain.com
