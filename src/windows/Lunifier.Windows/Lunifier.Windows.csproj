<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Authors>Silviu Vlasceanu</Authors>
    <Company>Silviu Vlasceanu</Company>
    <Product>Lunifier</Product>
    <AssemblyName>Lunifier</AssemblyName>
    <AssemblyTitle>Lunifier</AssemblyTitle>
    <Description>Seamless Logitech Easy-Switch Flow for Windows and Linux</Description>
    <Copyright>Copyright © 2026 Silviu Vlasceanu</Copyright>
    <Version>2.1.7</Version>
    <AssemblyVersion>2.1.7.0</AssemblyVersion>
    <FileVersion>2.1.7.0</FileVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
    <Resource Include="Resources\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
